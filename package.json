{
	"name": "@azure-net/kit",
	"version": "6.0.0-next.11",
	"license": "MIT",
	"author": "Pixel1917",
	"description": "Universal toolkit and library collection, developed as part of the Azure-net ecosystem",
	"homepage": "https://github.com/Pixel1917/azure-net-kit",
	"bugs": {
		"url": "https://github.com/Pixel1917/azure-net-kit/issues",
		"email": "sank195951@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Pixel1917/azure-net-kit.git"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest --config vitest.config.ts",
		"test:client": "vitest --config vitest.client.config.ts",
		"test:integration": "vitest --config vitest.integration.config.ts --run",
		"test": "pnpm test:unit -- --run && pnpm test:client -- --run && pnpm test:integration && pnpm test:e2e",
		"test:e2e": "playwright test",
		"commit": "pnpm format && git add .",
		"test:retention": "vitest --config vitest.retention.config.ts --run"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./infra": {
			"types": "./dist/infra.d.ts",
			"svelte": "./dist/infra.js"
		},
		"./delivery": {
			"types": "./dist/delivery.d.ts",
			"svelte": "./dist/delivery.js"
		},
		"./errors": {
			"types": "./dist/errors.d.ts",
			"svelte": "./dist/errors.js"
		},
		"./plugin": {
			"types": "./dist/plugin/index.d.ts",
			"svelte": "./dist/plugin/index.js",
			"import": "./dist/plugin/index.js"
		},
		"./server-context": {
			"types": "./dist/shared/request-context/index.d.ts",
			"svelte": "./dist/shared/request-context/index.js",
			"import": "./dist/shared/request-context/index.js"
		},
		"./tools": {
			"types": "./dist/external/tools/index.d.ts",
			"svelte": "./dist/external/tools/index.js"
		},
		"./i18n": {
			"types": "./dist/i18n/index.d.ts",
			"svelte": "./dist/i18n/index.js",
			"import": "./dist/i18n/index.js"
		},
		"./internal/server": {
			"types": "./dist/server/Context/Runtime.d.ts",
			"import": "./dist/server/Context/Runtime.js"
		}
	},
	"peerDependencies": {
		"@sveltejs/kit": ">=3.0.0",
		"svelte": ">=5.57.1"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^22",
		"env-cmd": "^11.0.0",
		"eslint": "^10.2.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.5.0",
		"jsdom": "^29.0.2",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"publint": "^0.3.18",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.2",
		"vite": "^8.0.12",
		"vitest": "^4.1.4"
	},
	"keywords": [
		"sveltekit",
		"svelte",
		"toolkit",
		"library",
		"azure-net",
		"store",
		"i18n",
		"utils"
	],
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
	"dependencies": {
		"@azure-net/tools": "^2.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": {
			"types": [
				"./src/lib/*.ts",
				"./src/lib/*/index.ts",
				"./src/lib/*"
			],
			"default": "./src/lib/*"
		}
	}
}
